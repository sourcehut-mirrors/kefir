.L__kefir_text_func_test2_begin:
    push %rbp
    mov %rsp, %rbp
    sub $16, %rsp
    movl %esi, -8(%rbp)
    movq %rdi, -16(%rbp)
    movl -8(%rbp), %edi
    movq -16(%rbp), %r8
.L__kefir_func_test2_label2:
    movl (%r8), %eax
    movsx %eax, %rax
    mov %rax, %rsi
    add %edi, %esi
    mov %r8, %rdx
    mov %esi, %ecx
    lock     cmpxchgl %ecx, (%rdx)
    jnz .L__kefir_func_test2_label2
    mov %esi, %eax
    lea (%rbp), %rsp
    pop %rbp
    ret
.L__kefir_text_func_test2_end:

