.section .text
.L__kefir_text_section_begin:
overflow_sadd:
.L__kefir_text_func_overflow_sadd_begin:
    movsx %edi, %rax
    movsx %esi, %rcx
    add %rax, %rcx
    seto %al
    movsx %ecx, %rsi
    cmp %rsi, %rcx
    setne %sil
    or %sil, %al
    and $1, %eax
    movl %ecx, (%rdx)
    ret
.L__kefir_text_func_overflow_sadd_end:

overflow_uadd:
.L__kefir_text_func_overflow_uadd_begin:
    mov %edi, %edi
    mov %esi, %esi
    add %rsi, %rdi
    seto %al
    mov %edi, %ecx
    cmp %rcx, %rdi
    setne %cl
    or %cl, %al
    and $1, %eax
    movl %edi, (%rdx)
    ret
.L__kefir_text_func_overflow_uadd_end:

overflow_saddl:
.L__kefir_text_func_overflow_saddl_begin:
    add %rsi, %rdi
    seto %al
    and $1, %eax
    movq %rdi, (%rdx)
    ret
.L__kefir_text_func_overflow_saddl_end:

overflow_uaddl:
.L__kefir_text_func_overflow_uaddl_begin:
    add %rsi, %rdi
    setc %al
    and $1, %eax
    movq %rdi, (%rdx)
    ret
.L__kefir_text_func_overflow_uaddl_end:

overflow_saddll:
.L__kefir_text_func_overflow_saddll_begin:
    add %rsi, %rdi
    seto %al
    and $1, %eax
    movq %rdi, (%rdx)
    ret
.L__kefir_text_func_overflow_saddll_end:

overflow_uaddll:
.L__kefir_text_func_overflow_uaddll_begin:
    add %rsi, %rdi
    setc %al
    and $1, %eax
    movq %rdi, (%rdx)
    ret
.L__kefir_text_func_overflow_uaddll_end:

.L__kefir_text_section_end:

