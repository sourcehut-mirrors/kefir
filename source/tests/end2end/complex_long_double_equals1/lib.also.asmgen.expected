.att_syntax
.section .note.GNU-stack,"",%progbits

.global cld_eq
.type cld_eq, @function
.global cld_trunc
.type cld_trunc, @function

.section .text
.L__kefir_text_section_begin:
cld_eq:
.L__kefir_text_func_cld_eq_begin:
    push %rbp
    mov %rsp, %rbp
    sub $16, %rsp
    fstcw -8(%rbp)
    fldt 16(%rbp)
    fldt 48(%rbp)
    fxch %st(1)
    xor %eax, %eax
    xor %ecx, %ecx
    fucomip %st(1)
    fstp %st(0)
    setnp %al
    cmovne %rcx, %rax
    fldt 32(%rbp)
    fldt 64(%rbp)
    fxch %st(1)
    xor %ecx, %ecx
    xor %edx, %edx
    fucomip %st(1)
    fstp %st(0)
    setnp %cl
    cmovne %rdx, %rcx
    and %ecx, %eax
    setne %al
    movzx %al, %rax
.L__kefir_text_func_cld_eq_epilogue:
    fldcw -8(%rbp)
    lea (%rbp), %rsp
    pop %rbp
    ret
.L__kefir_text_func_cld_eq_end:

cld_trunc:
.L__kefir_text_func_cld_trunc_begin:
    push %rbp
    mov %rsp, %rbp
    sub $16, %rsp
    fstcw -8(%rbp)
    fldt 16(%rbp)
    fldt 32(%rbp)
    fldz
    fucomi %st(1)
    fstp %st(0)
    setp %al
    setne %cl
    or %al, %cl
    fxch %st(1)
    fldz
    fucomi %st(1)
    fstp %st(0)
    mov %rax, %rdx
    setp %dl
    setne %al
    or %dl, %al
    or %cl, %al
    fstp %st(0)
    fstp %st(0)
.L__kefir_text_func_cld_trunc_epilogue:
    fldcw -8(%rbp)
    lea (%rbp), %rsp
    pop %rbp
    ret
.L__kefir_text_func_cld_trunc_end:

.L__kefir_text_section_end:

